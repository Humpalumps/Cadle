 {"log":"--- sentinel: ranged opener on a melee role, then it CLOSES ---"},
 {"eval":"(()=>{const G=window.__game,p=G.game.player.position;G.clearEnemies();G.passive(true);const e=G.spawn('sentinel',p.x+26,p.z);G._r={kinds:{},minD:999,maxD:0,states:{}};G._rt=setInterval(()=>{if(!e||!e.alive)return;const pp=G.game.player.position,dd=Math.hypot(pp.x-e.position.x,pp.z-e.position.z);G._r.minD=Math.min(G._r.minD,dd);G._r.maxD=Math.max(G._r.maxD,dd);G._r.states[e.state]=(G._r.states[e.state]||0)+1;if(e.state==='attack'&&e.attackKind)G._r.kinds[e.attackKind]=(G._r.kinds[e.attackKind]||0)+1;},50);G.passive(false);e.alert=true;e.seen=true;return 'engaged';})()"},
 {"wait":16},
 {"shot":"sentinel-close"},
 {"eval":"(()=>{clearInterval(window.__game._rt);const r=window.__game._r;return `sentinel minD ${r.minD.toFixed(1)} maxD ${r.maxD.toFixed(1)} kinds ${JSON.stringify(r.kinds)} states ${JSON.stringify(r.states)}`;})()"},

