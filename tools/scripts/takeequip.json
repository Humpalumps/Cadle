[
  {"wait": 10},
  {"eval": "window.__game.god(true); window.__game.teleport(40,null,-40); 'tp'"},
  {"wait": 2},
  {"eval": "JSON.stringify({before: (window.__game.game.rpg.ctx.rpg.equipped.weaponA||{}).name, held: window.__game.game.player.weapons.index})"},
  {"eval": "const p=window.__game.game.player.position; window.__game.game.rpg.dropLoot({x:p.x+1.2,y:p.y,z:p.z-1.2},'legendary',{kind:'weapon'}); 'dropped'"},
  {"wait": 2.5},
  {"eval": "JSON.stringify({prompt: window.__game.game.hud._promptShown})"},
  {"shot": "takeequip-prompt"},
  {"eval": "window.__game.input.press('KeyT'); 'T'"},
  {"wait": 0.2},
  {"eval": "window.__game.input.release('KeyT'); 'up'"},
  {"wait": 2},
  {"eval": "const e=window.__game.game.rpg.ctx.rpg.equipped; JSON.stringify({weaponA:(e.weaponA||{}).name, weaponB:(e.weaponB||{}).name, ammo: window.__game.ammo().map(w=>w.archetype)})"}
]
