# Hostinger/Apache. Vite copies everything in public/ into dist/ verbatim, this included.
#
# Measured on cadle.gg 2026-08-22: assets came back with NO Cache-Control header at all and
# `x-hcdn-cache-status: DYNAMIC` — so the CDN never held them, and every visit re-validated
# every file against origin. guy.glb also arrived as `content-type: text/plain`.

<IfModule mod_headers.c>
  # Vite build output: content-hashed name, so the bytes behind a URL can never change.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The asset pack is NOT content-hashed (guy.glb, grass_albedo.jpg, ...), so it cannot be
  # immutable — a day is enough to kill the per-visit revalidation storm while still letting
  # a re-generated asset reach returning players the next day.
  <FilesMatch "\.(glb|jpg|jpeg|png|webp|mp3|ogg|ktx2)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # The only mutable entry point. Never hold it, or a deploy is invisible.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType image/ktx2 .ktx2
</IfModule>

# GLB (meshopt geometry + WebP textures inside), mp3 and jpg are already compressed —
# re-compressing them costs CPU at both ends for ~5% (guy.glb: 484 KB -> 453 KB).
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.(glb|jpg|jpeg|png|webp|mp3|ogg|ktx2)$ no-gzip dont-vary
</IfModule>
