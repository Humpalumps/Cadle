# Hostinger/Apache. Vite copies everything in public/ into dist/ verbatim, this included.
#
# Measured on cadle.gg 2026-08-22: assets came back with NO Cache-Control header at all and
# `x-hcdn-cache-status: DYNAMIC` — so the CDN never held them, and every visit re-validated
# every file against origin, and .glb arrived as `content-type: text/plain`.

<IfModule mod_headers.c>
  # Vite build output: content-hashed name, so the bytes behind a URL can never change.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The asset pack is NOT content-hashed (grass_albedo.jpg, menu_vista.jpg, ...), so it cannot be
  # immutable — a day is enough to kill the per-visit revalidation storm while still letting
  # a re-generated asset reach returning players the next day.
  <FilesMatch "\.(glb|jpg|jpeg|png|webp|mp3|ogg|ktx2)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # The only mutable entry points — / and /play/. FilesMatch tests the basename, so this covers
  # both index.html files. Never hold them, or a deploy is invisible.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType image/ktx2 .ktx2
</IfModule>

# mp3, jpg and friends are already compressed — re-compressing them costs CPU at both ends for ~5%.
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.(glb|jpg|jpeg|png|webp|mp3|ogg|ktx2)$ no-gzip dont-vary
</IfModule>

# /play (no trailing slash) must serve the GAME, not a redirect and not the landing page.
#
# The site is two pages: `/` is cadle.gg and `/play/` is the game. Apache's mod_dir would answer a bare
# `/play` with a 301 to `/play/`, which works but costs a round trip on the one navigation that matters
# — and the landing page's Play button links to `/play?start`. Serve it directly instead.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^play/?$ /play/index.html [L]
</IfModule>
